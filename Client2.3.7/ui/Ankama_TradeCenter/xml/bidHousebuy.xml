			</Anchors>
			<Size>
				<AbsDimension x="462" y="315" />
			</Size>
		</Container>




		<!-- Texture tx_BackgroundGrid -->

		<Texture>
			<Anchors>
				<Anchor>
					<AbsDimension x="24" y="345" />
