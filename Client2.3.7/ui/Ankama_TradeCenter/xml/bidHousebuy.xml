			<Size>
				<AbsDimension x="455" y="332" />
			</Size>
			<autoGrid>true</autoGrid>
			<uri>[local.assets]tx_blockBackground</uri>
		</Texture>






		<!-- Grid gd_list-->

		<Grid name="gd_list">
			<Anchors>
				<Anchor>
					<AbsDimension x="27" y="365" />
				</Anchor>
			</Anchors>
			<Size>
				<AbsDimension x="446" y="288" />
			</Size>
			<rendererName>com.ankamagames.berilia.components.gridRenderer::XmlUiGridRenderer</rendererName>
			<rendererArgs>Ankama_TradeCenter::buyModeXmlItem,[colors.grid.line]</rendererArgs>
			<verticalScrollbarCss>[local.css]scrollBar.css</verticalScrollbarCss>
			<slotWidth>428</slotWidth>
			<slotHeight>48</slotHeight>
			<Hooks>
				<onSelectItem />
			</Hooks>
		</Grid>




		<!-- Texture tx_foregroundGrid-->

