				<Anchor>
					<AbsDimension x="240" y="9" />
				</Anchor>
			</Anchors>
			<Size>
				<AbsDimension x="120" y="20" />
			</Size>
			<text>[ui.common.ownerWord]</text>
			<css>[local.cssGridMenu]</css>
		</Label>

		<sortButton name="btn_tabOwner">
			<Anchors>
				<Anchor>
					<AbsDimension x="231" y="8" />
				</Anchor>
			</Anchors>
			<Size>
				<AbsDimension x="144" y="25" />
			</Size>
		</sortButton>

		<Grid name="grid_house">
			<Anchors>
				<Anchor>
					<AbsDimension x="0" y="35" />
				</Anchor>
			</Anchors>
			<Size>
				<AbsDimension x="405" y="455" />
			</Size>
			<rendererName>com.ankamagames.berilia.components.gridRenderer::XmlUiGridRenderer</rendererName>
			<rendererArgs>Ankama_Social::guildHouseXmlItem,[colors.grid.line]</rendererArgs>
			<slotWidth>376</slotWidth>
			<slotHeight>41</slotHeight>
			<verticalScrollbarCss>[local.css]scrollBar.css</verticalScrollbarCss>
		</Grid>
		
		<Texture name="tx_gridHouse">
			<Anchors>
				<Anchor>
					<AbsDimension x="0" y="5" />
				</Anchor>
			</Anchors>
			<Size>
				<AbsDimension x="420" y="515" />
			</Size>
			<uri>[local.assets]SocialGuildeMaisons_tx_grilleGauche</uri>
			<autoGrid>false</autoGrid>
		</Texture>

		<!-- FLECHE DROITE -->
		
		<Texture name="tx_arrow">
			<Anchors>
				<Anchor>
					<AbsDimension x="430" y="252" />
				</Anchor>
			</Anchors>
			<Size>
				<AbsDimension x="25" y="40" />
			</Size>
			<uri>[local.assets]tx_flecheombre</uri>
			<autoGrid>false</autoGrid>
		</Texture>
		
		
		
		<!-- PARTIE DROITE -->

		<Texture name="slot_house">
			<Anchors>
				<Anchor>
					<AbsDimension x="465" y="5" />
				</Anchor>
			</Anchors>
			<Size>
				<AbsDimension x="420" y="160" />
			</Size>
			<uri>[local.assets]tx_darkBg</uri>
			<autoGrid>true</autoGrid>
		</Texture>

		<!-- ICONE MAISON -->
		
		<Texture name="tx_illusBg">
			<Anchors>
				<Anchor>
					<AbsDimension x="473" y="15" />
				</Anchor>
			</Anchors>
			<Size>
				<AbsDimension x="145" y="146" />
			</Size>
			<uri>[local.assets]SocialGuildeMaisons_tx_cadreIllusMaisons</uri>
			<autoGrid>false</autoGrid>
		</Texture>

		<Texture name="tx_house">
			<Anchors>
				<Anchor relativePoint="BOTTOMLEFT" point="BOTTOMLEFT" relativeTo="tx_illusBg" >
					<AbsDimension x="2" y="-2" />
				</Anchor>
			</Anchors>
			<Size>
				<AbsDimension x="114" y="163" />
			</Size>
			<autoGrid>false</autoGrid>
		</Texture>

		<!-- INFORMATIONS MAISON -->

		<Container>
			<Anchors>
				<Anchor>
					<AbsDimension x="625" y="11" />
				</Anchor>
