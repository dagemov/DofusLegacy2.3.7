			<Size>
				<AbsDimension x="252" y="140" />
			</Size>
		
			<!-- Label lbl_name-->

			<Label name="lbl_house">
				<Size>
					<AbsDimension x="252" y="55" />
				</Size>
				<css>[local.css]titleSmall.css</css>
				<multiline>true</multiline>
				<wordWrap>true</wordWrap>
			</Label>

			<Label>
				<Anchors>
					<Anchor>
						<AbsDimension x="0" y="55" />
					</Anchor>
				</Anchors>
				<Size>
					<AbsDimension x="126" y="20" />
				</Size>
				<text>[ui.common.ownerWord] :</text>
				<css>[local.css]normal.css</css>
			</Label>

			<Label>
				<Anchors>
					<Anchor>
						<AbsDimension x="0" y="75" />
					</Anchor>
				</Anchors>
				<Size>
					<AbsDimension x="136" y="20" />
				</Size>
				<text>[ui.common.coordinates] :</text>
				<css>[local.css]normal.css</css>
			</Label>

			<!-- Label lbl_owner-->

			<Label name="lbl_owner">
				<Anchors>
					<Anchor>
						<AbsDimension x="126" y="55" />
					</Anchor>
				</Anchors>
				<Size>
					<AbsDimension x="126" y="20" />
				</Size>
				<css>[local.css]normal.css</css>
				<cssClass>right</cssClass>
			</Label>

			<!-- Label lbl_coord-->

			<Label name="lbl_coord">
				<Anchors>
					<Anchor>
						<AbsDimension x="136" y="75" />
					</Anchor>
				</Anchors>
				<Size>
					<AbsDimension x="116" y="20" />
				</Size>
				<css>[local.css]normal.css</css>
				<cssClass>right</cssClass>
			</Label>


			<!-- simpleButton btn_join-->

			<simpleButton name="btn_join">
				<Anchors>
					<Anchor>
						<AbsDimension x="1" y="105" />
					</Anchor>
				</Anchors>

				<uri>[local.assets]btn_orange</uri>

				<Size>
					<AbsDimension x="250" y="35" />
				</Size>
				<label>[ui.common.join]</label>
				<css>[local.css]button.css</css>
			</simpleButton>

