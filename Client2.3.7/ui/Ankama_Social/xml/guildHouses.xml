				<Anchor>
					<AbsDimension x="18" y="9" />
				</Anchor>
			</Anchors>
			<Size>
				<AbsDimension x="120" y="20" />
			</Size>
			<text>[ui.common.houseWord]</text>
			<css>[local.cssGridMenu]</css>
		</Label>

		<sortButton name="btn_tabHouse">
			<Anchors>
				<Anchor>
					<AbsDimension x="0" y="8" />
				</Anchor>
			</Anchors>
			<Size>
				<AbsDimension x="228" y="25" />
			</Size>
		</sortButton>

		<Label name="lbl_tabOwner">
