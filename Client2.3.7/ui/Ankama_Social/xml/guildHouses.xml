				<Label name="lbl_skill">
					<Anchors>
						<Anchor>
							<AbsDimension x="10" y="6" />
						</Anchor>
					</Anchors>
					<Size>
						<AbsDimension x="362" y="21" />
					</Size>
					<css>[local.css]normal.css</css>
				</Label>
			</Container>
		
