				</Size>
				<css>[local.css]normal.css</css>
			</Label>
			
			<Grid name="grid_character">
				<Anchors>
					<Anchor>
						<AbsDimension x="10" y="125" />
					</Anchor>
				</Anchors>
				<Size>
					<AbsDimension x="310" y="360" />
				</Size>
				<rendererName>com.ankamagames.berilia.components.gridRenderer::XmlUiGridRenderer</rendererName>
				<rendererArgs>characterSelectionXmlItem,[colors.grid.line],[colors.grid.bg]</rendererArgs>
				<slotWidth>287</slotWidth>
				<slotHeight>30</slotHeight>
				<verticalScrollbarCss>[local.css]scrollBar.css</verticalScrollbarCss>
				<Hooks>
					<onSelectItem />
				</Hooks>
			</Grid>

		</Container>
		
				
	</Container>
	
	<Shortcuts>
		<validUi />
		<rightArrow />
		<leftArrow />
	</Shortcuts>
</Definition>