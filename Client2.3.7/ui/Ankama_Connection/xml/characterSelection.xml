					<Anchor>
						<AbsDimension x="265" y="425" />
					</Anchor>
				</Anchors>
				<Size>
					<AbsDimension x="40" y="62" />
				</Size>
				<uri>[local.assets]btn_bigArrow_left</uri>
				<Hooks>
					<onRelease />
					<onDoubleClick />
				</Hooks>
			</iconButton>

			<!-- Button btn_grosseflechedroite-->

			<iconButton name="btn_bigArrowRight">
