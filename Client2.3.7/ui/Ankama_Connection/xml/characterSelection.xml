				</Anchors>
				<Size>
					<AbsDimension x="40" y="62" />
				</Size>
				<uri>[local.assets]btn_bigArrow_right</uri>
				<Hooks>
					<onRelease />
					<onDoubleClick />
				</Hooks>
			</iconButton>
			
			
			<!-- Button btn_flecheorangegauche-->

			<iconButton name="btn_leftArrow">
				<Anchors>
					<Anchor>
						<AbsDimension x="575" y="500" />
					</Anchor>
				</Anchors>
				<Size>
					<AbsDimension x="16" y="24" />
				</Size>
				<uri>[local.assets]btn_flechegauche</uri>
				<Hooks>
					<onRelease />
					<onDoubleClick />
				</Hooks>
			</iconButton>

			<!-- Button btn_flecheorangedroite-->

			<iconButton name="btn_rightArrow">
				<Anchors>
					<Anchor>
						<AbsDimension x="485" y="500" />
					</Anchor>
				</Anchors>
				<Size>
					<AbsDimension x="16" y="24" />
				</Size>
				<uri>[local.assets]btn_flechedroite</uri>
				<Hooks>
					<onRelease />
					<onDoubleClick />
				</Hooks>
			</iconButton>
			

			<!-- Texture tx_decoboutonroange_back-->

			<Texture name="tx_btnPlayBack">
				<Anchors>
					<Anchor>
						<AbsDimension x="374" y="645" />
					</Anchor>
				</Anchors>
				<Size>
					<AbsDimension x="354" y="60" />
				</Size>
				<uri>[local.assets]tx_decobtn_back</uri>
			</Texture>	

			<!-- Button btn_create label="[ui.common.play]" -->		

			<simpleButton label="[ui.common.play]" name="btn_play"   >
			<Size>
				<AbsDimension x="123" y="40" />
			</Size>
				<Anchors>
					<Anchor>
						<AbsDimension x="481" y="652" />
					</Anchor>
				</Anchors>
				<css>[local.css]button.css</css>
				<Hooks>
					<onRelease />
				</Hooks>
			</simpleButton>
			
			<!-- Texture tx_decoboutonorange_front-->

			<Texture name="tx_btnPlayFront">
