					</Anchor>
				</Anchors>
				<Size>
					<AbsDimension x="317" y="20" />
				</Size>
				<css>[local.css]titleSmall.css</css>
				<cssClass>center</cssClass>
				<text>[ui.split.unavailableCharacter]</text>
				<visible>false</visible>
			</Label>

			<Container name="hardcoreCtr">

				<Anchors>
					<Anchor relativePoint="TOP" point="TOP" />
				</Anchors>
				<visible>false</visible>


				<!-- Texture tx_deathCounter -->
	
				<Texture name="tx_deathCounter">
					<Anchors>
						<Anchor relativePoint="TOP" point="TOP">
							<AbsDimension x="0" y="170" />
						</Anchor>
					</Anchors>
					<Size>
						<AbsDimension x="185" y="99" />
					</Size>
					<gotoAndStop>12</gotoAndStop>
					<uri>[local.assets]Heroique_ptx_CranesSelectionPersos</uri>
				</Texture>
	
				<!-- Label lbl_deathCounter -->
	
				<Label name="lbl_deathCounter">
					<Anchors>
						<Anchor relativePoint="TOP" point="TOP">
							<AbsDimension x="0" y="215" />
						</Anchor>
					</Anchors>
					<Size>
						<AbsDimension x="60" y="20" />
					</Size>
					<css>[local.css]normal.css</css>
					<cssClass>darkcenter</cssClass>
				</Label>
				
