<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE Definition SYSTEM "../dtd/ui.dtd">
<Definition useCache="true">
	
	<Import url="[config.mod.template]button/greyButton.xml" />
	<Import url="[config.mod.template]button/simpleButton.xml" />
	<Import url="[config.mod.template]button/iconButton.xml" />
	
	<Constants>
		<Constant name="assets" value="[config.ui.skin]assets.swf|" />
		<Constant name="css" value="[config.ui.skin]css/" />	
		<Constant name="bases_uri" value="[config.content.path]gfx/bases/" />
		<Constant name="cssGridMenu" value="[config.ui.skin]css/normal.css" />
	</Constants>

	<Container name="charaSelCtr">
		<Anchors>
			<Anchor point="TOP" relativePoint="TOP" >
				<!--AbsDimension x="11" y="217" /-->
				<AbsDimension x="0" y="217" />
			</Anchor>
		</Anchors>
		
		<Container name="midZCtr">
		
			<!-- Texture tx_selectionperso_background-->
			
			<Texture name="tx_selectionperso_background">
				<Anchors>
					<Anchor>
						<AbsDimension x="317" y="6" />
					</Anchor>
				</Anchors>
				<Size>
					<AbsDimension x="453" y="657" />
				</Size>
				<uri>[local.assets]Selectionperso_tx_background</uri>
			</Texture>	


			<!-- CharacterWheel -->
			
			<CharacterWheel name ="charaWheel">
				<Anchors>
					<Anchor>
						<AbsDimension x="540" y="360" />
					</Anchor>
				</Anchors>
				<Size>
					<AbsDimension x="390" y="164" />
				</Size>
				<mountainUri>[local.bases_uri]</mountainUri>
				<Hooks>
					<onRelease />
				</Hooks>
			</CharacterWheel>
			
			<!-- Label lbl_name-->

			<Label name="lbl_name">
				<Anchors>
					<Anchor>
						<AbsDimension x="417" y="57" />
					</Anchor>
				</Anchors>
				<Size>
					<AbsDimension x="235" y="23" />
				</Size>
				<css>[local.css]titleSmall.css</css>
				<cssClass>center</cssClass>
			</Label>

			<!-- Label charLevel0-->

			<Label name="lbl_level">
				<Anchors>
					<Anchor>
						<AbsDimension x="460" y="90" />
					</Anchor>
				</Anchors>
				<Size>
					<AbsDimension x="175" y="23" />
				</Size>
				<css>[local.css]normal.css</css>
				<cssClass>darkcenter</cssClass>
			</Label>

		</Container>


		

		<!-- Label lbl_titleSelection-->

		<Label name="lbl_titleSelection">
			<Anchors>
				<Anchor point="TOP" relativePoint="TOP" >
					<AbsDimension x="0" y="-5" />
				</Anchor>
			</Anchors>
			<Size>
				<AbsDimension x="700" y="30" />
			</Size>
			<text>[ui.charsel.title]</text>
			<css>[local.css]title.css</css>
			<cssClass>center</cssClass>
		</Label>
		

		


		
		
		<Container name="frontZCtr">

			<!-- Button btn_croix-->

			<iconButton name="btn_cross">
				<Anchors>
					<Anchor>
						<AbsDimension x="647" y="63" />
					</Anchor>
				</Anchors>
				<Size>
					<AbsDimension x="18" y="18" />
				</Size>
				<uri>[local.assets]Selectionperso_btn_croix</uri>
			</iconButton>
			
			
			
			<!-- Button btn_creerperso-->

			<greyButton label="[ui.charsel.createCharacter]" name="btn_create" width="228" height="35">
				<Anchors>
					<Anchor>
						<AbsDimension x="853" y="527" />
					</Anchor>
				</Anchors>
				<css>[local.css]button.css</css>
				<cssClass>small</cssClass>
				<Hooks>
					<onRelease />
				</Hooks>
			</greyButton>


			<!-- Button btn_changerserveur-->

			<greyButton label="[ui.charsel.changeServer]" name="btn_changeServer" width="228" height="35">
				<Anchors>
					<Anchor>
						<AbsDimension x="0" y="527" />
					</Anchor>
				</Anchors>
				<css>[local.css]button.css</css>
				<cssClass>small</cssClass>
				<Hooks>
					<onRelease />
				</Hooks>
			</greyButton>


			<!-- Button btn_grosseflechegauche-->

			<iconButton name="btn_bigArrowLeft">
