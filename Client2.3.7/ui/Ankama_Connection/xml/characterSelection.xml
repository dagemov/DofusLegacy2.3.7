						<AbsDimension x="350" y="32" />
					</Size>
					<Anchors>
						<Anchor relativePoint="TOP" point="TOP">
							<AbsDimension x="0" y="600" />
						</Anchor>
					</Anchors>
					<cssClass>small</cssClass>
					<Hooks>
						<onRelease />
