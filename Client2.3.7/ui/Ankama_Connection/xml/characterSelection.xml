				<Size>
					<AbsDimension x="191" y="41" />
				</Size>
				<uri>[local.assets]tx_decobtn_front</uri>
			</Texture>

			<!-- Label lbl_deathCounter -->

			<Label name="lbl_unusableCharacter">
