<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE Definition SYSTEM "../dtd/ui.dtd">
<Definition>

	<Import url="[config.mod.template]button/simpleButton.xml" />
	<Import url="[config.mod.template]button/greyButton.xml" />
	
	<Constants>
		<Constant name="assets" value="[config.ui.skin]assets.swf|" />
		<Constant name="illu" value="[config.content.path]gfx/illusUi/" />
		<Constant name="css" value="[config.ui.skin]css/" />
	</Constants>
	
	<Container name="serverCtr">
		<Size>
			<AbsDimension x="1119" y="546" />
		</Size>
		<Anchors>
			<Anchor point="TOP" relativePoint="TOP" >
				<AbsDimension x="-11" y="58" />
			</Anchor>
		</Anchors>

		<!-- Texture tx_illu-->

		<Texture>
			<Anchors>
				<Anchor>
					<AbsDimension x="14" y="0" />
				</Anchor>
			</Anchors>
			<Size>
				<AbsDimension x="1113" y="670" />
			</Size>
			<uri>[local.illu]simpleServerChoiceIllu.png</uri>
		</Texture>
				
		
		<!-- Label lbl_title-->

		<Label name="lbl_title">
			<Anchors>
				<Anchor point="TOP" relativePoint="TOP" >
					<AbsDimension x="0" y="156" />
				</Anchor>
			</Anchors>
			<Size>
				<AbsDimension x="700" y="30" />
			</Size>
			<text>[ui.sersel.choseServer]</text>
			<css>[local.css]title.css</css>
			<cssClass>center</cssClass>
		</Label>
		
		<!-- Texture tx_bgBtn-->

		<Texture>
			<Anchors>
				<Anchor>
					<AbsDimension x="0" y="172" />
				</Anchor>
			</Anchors>
			<Size>
				<AbsDimension x="1143" y="589" />
			</Size>
			<uri>[local.assets]tx_serverchoice_bottomBg</uri>
		</Texture>


		<!-- Button btn_autochoice -->		

		<simpleButton label="[ui.sersel.autoChoice]" name="btn_autochoice">
			<Anchors>
				<Anchor>
					<AbsDimension x="279" y="681" />
				</Anchor>
			</Anchors>
			<Size>
				<AbsDimension x="380" y="59" />
			</Size>
			<multiline>true</multiline>
		</simpleButton>

		<!-- Button btn_mychoice -->		

		<greyButton label="[ui.sersel.manualChoice]" name="btn_mychoice" width="241" height="35">
			<Anchors>
				<Anchor>
					<AbsDimension x="879" y="684" />
				</Anchor>
			</Anchors>
			<css>[local.css]button.css</css>
			<cssClass>small</cssClass>
			<Hooks>
				<onRelease />
			</Hooks>
		</greyButton>
		
	</Container>
</Definition>
