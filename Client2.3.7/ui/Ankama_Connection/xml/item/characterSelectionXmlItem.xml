<?xml version="1.0" encoding="UTF-8"?>
<Definition>
	
	<Constants>
		<Constant name="assets" value="[config.ui.skin]assets.swf|" />
		<Constant name="css" value="[config.ui.skin]css/" />
	</Constants>

	<Container name="mainCtr">
		
		<Button name="btn_character">
		
			<Common>			
				<Size>
					<AbsDimension x="287" y="30" />
				</Size>
				<radioMode>true</radioMode>
				
				<Container>		
					<Size>
						<AbsDimension x="287" y="30" />
					</Size>
					<bgColor>0</bgColor>
					<bgAlpha>0</bgAlpha>
				</Container>
				
				<Label name="lbl_name">	
					<Anchors>
						<Anchor>
							<AbsDimension x="5" y="2" />
						</Anchor>
					</Anchors>
					<Size>
						<AbsDimension x="277" y="20" />
					</Size>
					<css>[local.css]normal.css</css>
				</Label>
			</Common>
			
			<State type="OVER">
				<SetProperties target="btn_character">
					<bgColor>[colors.grid.over]</bgColor>
				</SetProperties>
			</State>
			
			<State type="SELECTED">
				<SetProperties target="btn_character">
					<bgColor>[colors.grid.selected]</bgColor>
				</SetProperties>
			</State>
			
			<State type="SELECTED_OVER">
				<SetProperties target="btn_character">
					<bgColor>[colors.grid.selected]</bgColor>
				</SetProperties>
			</State>
		</Button>
	</Container>
</Definition>