{
  "name": "onelauncher",
  "version": "1.0.13",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --publish never",
    "icon:generate": "python ../../scripts/generate-launcher-icon.py",
    "build:windows": "electron-builder --win --publish never",
    "build:windows:publish": "electron-builder --win --publish always",
    "publish:vps": "powershell -ExecutionPolicy Bypass -File ..\\..\\scripts\\publish-launcher-to-vps.ps1",
    "build:mac": "electron-builder --mac --publish never",
    "build:linux": "electron-builder --linux --publish never",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "game-launcher",
    "electron",
    "updater"
  ],
  "author": "Rollblack Legacy",
  "license": "ISC",
  "description": "Launcher Rollblack Legacy: actualiza el cliente Dofus y el propio launcher desde el VPS.",
  "dependencies": {
    "adm-zip": "^0.5.16",
    "axios": "^1.8.4",
    "7zip-bin": "^5.2.0",
    "electron-updater": "^6.1.1",
    "extract-zip": "^2.0.1",
    "fs-extra": "^11.3.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "electron": "^35.1.2",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.onesv.launcher",
    "productName": "Onelauncher",
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "asarUnpack": [
      "extractor-worker.js",
      "node_modules/7zip-bin/**"
    ],
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "extractor-worker.js",
      "config/**/*",
      "services/**/*",
      "index.html",
      "styles.css",
      "icons/**/*",
      "icons/flags/**/*",
      "!icons/favicon.icns"
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://rollblack-legacy.onesv.online/api/launcher/electron-updates",
        "useMultipleRangeRequest": false
      }
    ],
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "icons/app-icon.ico",
      "uninstallerIcon": "icons/app-icon.ico",
      "differentialPackage": true,
      "include": "build/installer.nsh"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icons/app-icon.ico",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": "dmg",
      "icon": "icons/favicon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "icons/favicon.png"
    }
  }
}
