# Public host returned to the Dofus client through worlds.Id=18.
WORLD_PUBLIC_HOST=127.0.0.1

# TCP port published for the auth server.
AUTH_PORT=2450

# TCP port published for the world server.
WORLD_PORT=5557

# ProtocolRequired version sent during the auth/world handshake.
PROTOCOL_VERSION=1375

# Host bind used by Docker for the auth port publication.
AUTH_PUBLISH_HOST=127.0.0.1

# Host bind used by Docker for the world port publication.
WORLD_PUBLISH_HOST=127.0.0.1

# Database name used by MariaDB and Sunshine.
MYSQL_DATABASE=sunshine

# Root password for the MariaDB container.
MYSQL_ROOT_PASSWORD=change-me-root

# Application user consumed by Sunshine inside Compose.
MYSQL_APP_USER=sunshine

# Application password consumed by Sunshine inside Compose.
MYSQL_APP_PASSWORD=change-me-app

# Host bind used by Docker for the published MySQL port.
# Keep this on 127.0.0.1 for the host-run Sunshine process.
# Avoid localhost because it can resolve to a different local MySQL listener.
MYSQL_PUBLISH_HOST=127.0.0.1

# Host port published for MariaDB.
MYSQL_PUBLISH_PORT=3306

# Remote user granted with host % for admin tools or external access.
MYSQL_REMOTE_USER=sunshine_remote

# Remote password granted with host % for admin tools or external access.
MYSQL_REMOTE_PASSWORD=change-me-remote

# Optional gameplay rate consumed by Config.xml generation.
RATE_XP=3

# Optional gameplay rate consumed by Config.xml generation.
RATE_DROP=1

# Optional gameplay rate consumed by Config.xml generation.
RATE_JOB_XP=5

# Optional gameplay rate consumed by Config.xml generation.
RATE_MOUNT_XP=1

# Optional gameplay rate consumed by Config.xml generation.
RATE_KAMAS=2

# Optional autosave interval in minutes consumed by Config.xml generation.
AUTO_SAVE_INTERVAL=5
