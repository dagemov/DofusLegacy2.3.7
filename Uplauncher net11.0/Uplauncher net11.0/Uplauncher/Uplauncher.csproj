<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Uplauncher</RootNamespace>
    <AssemblyName>Uplauncher</AssemblyName>
    <StartupObject>Uplauncher.App</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>updater.ico</ApplicationIcon>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);SYSLIB0014</NoWarn>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|AnyCPU'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU'">
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Include="App\App.xaml" />
    <Page Include="App\DialogBaseControl.xaml" />
    <Page Include="App\Main.xaml" />
    <Page Include="App\VersionCheckControl.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Zip\**\*.cs" />
    <Compile Remove="Settings.cs" />
    <Compile Remove="Properties\Settings.Designer.cs" />
    <None Remove="UI\**\*" />
    <None Remove="updater.ico" />
    <None Remove="Ftp\config.json" />
    <EmbeddedResource Remove="data\configuration_origin.xml" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="UI\**\*" />
    <Resource Include="updater.ico" />
    <EmbeddedResource Include="data\configuration_origin.xml" LogicalName="Uplauncher.data.configuration_origin.xml" />
    <Content Include="Ftp\config.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
