<UserControl 
    x:Class="Uplauncher.VersionCheckControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	Background="Transparent" xmlns:Uplauncher="clr-namespace:Uplauncher">
    <Grid>
        <Grid.ColumnDefinitions>
        <ColumnDefinition Width="361*"/>
        <ColumnDefinition Width="139*"/>
    </Grid.ColumnDefinitions>
    <Label
			Content="Veuillez patienter pendant que le lanceur analyse les fichiers actuels de votre client pour trouver ceux qui sont obsolètes..."
			Foreground="#FFFFFFFF"
			Height="25"
			Margin="0 0 0 20" Grid.ColumnSpan="2" />
    <ProgressBar
			Name="StatusProgressBar"
			HorizontalAlignment="Stretch"
			Value="10"
			Height="5"
			Width="500"
            Foreground="#FF3498DB"
			Margin="0,30,0,10" Grid.ColumnSpan="2" />
    </Grid>

</UserControl>
