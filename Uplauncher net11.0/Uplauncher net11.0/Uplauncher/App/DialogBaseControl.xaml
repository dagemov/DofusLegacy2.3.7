<UserControl 
    x:Class="Uplauncher.DialogBaseControl"
    x:ClassModifier="internal" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"  
    Name="root" xmlns:dialogs="clr-namespace:Uplauncher">
    <Grid>
        <ContentControl
			Name="BackgroundImageHolder"
			ClipToBounds="True" />
        <Border
			Background="#50e8e3ea"
			HorizontalAlignment="Stretch"
			VerticalAlignment="Stretch"
			DataContext="{Binding ElementName=root}">
            <Grid
				Margin="30"
				HorizontalAlignment="{Binding HorizontalDialogAlignment}"
				VerticalAlignment="{Binding VerticalDialogAlignment}">
                <ContentControl
					Style="{StaticResource ContentStyle1}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition
								Height="Auto" />
                            <RowDefinition
								Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel
							Background= "#160f26">
                            <TextBlock
								TextAlignment="Left"
								Margin="10 10 0 10"
								FontSize="13"
								Foreground="#FFFFFFFF"
								Text="{Binding Caption}" />
                        </StackPanel>
                        <StackPanel
							Grid.Row="0"
							Orientation="Horizontal"
							HorizontalAlignment="Right"
							VerticalAlignment="Center"
							Margin="0 10 10 10">
                            <Button
								Content="Close"
								Style="{StaticResource FormCloseIcon}"
								Click="Button_Click" />
                        </StackPanel>
                        <DockPanel
							Grid.Row="1">
                            <UniformGrid
								Name="ButtonsGrid"
								DockPanel.Dock="Bottom"
								VerticalAlignment="Bottom"
								Margin="10"
								HorizontalAlignment="Center" />
                            <ContentPresenter
								Name="CustomContent"
								Margin="10 10 10 0" />
                        </DockPanel>
                    </Grid>
                </ContentControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>
