    private async Task OnTypeChanged(ChangeEventArgs args)
    {
        if (!short.TryParse(args.Value?.ToString(), out var rawType))
            return;

        _form.TypeId = (ItemType)rawType;
        await LoadAppearanceOptionsAsync();
    }

    private async Task OnAppearanceChanged(ChangeEventArgs args)
    {
        if (!short.TryParse(args.Value?.ToString(), out var appearanceId))
            return;

        _form.AppearanceId = appearanceId;
        await LoadAppearanceOptionsAsync();
    }

    private async Task LoadAppearanceOptionsAsync()
    {
        _appearanceOptions = await ItemAppearanceCatalogService.GetOptionsAsync(_form.TypeId);
        _showInvalidAppearanceOption = _form.AppearanceId > 0 && !_appearanceOptions.Any(x => x.AppearanceId == _form.AppearanceId);

        if (_form.AppearanceId < -1)
            _form.AppearanceId = -1;

        if (_appearanceOptions.Count == 0)
            return;

        if (_form.AppearanceId is > 0 && (_showInvalidAppearanceOption || _appearanceOptions.Any(x => x.AppearanceId == _form.AppearanceId)))
            return;

        if (_form.AppearanceId is 0 or -1)
            return;

        if (!_appearanceOptions.Any(x => x.AppearanceId == _form.AppearanceId))
            _form.AppearanceId = -1;
    }

    private async Task UploadManualAssetAsync(InputFileChangeEventArgs args)
    {
        if (_form.Id <= 0)
        {
            _error = "Guarda primero un Id valido antes de asociar un PNG manual.";
            return;
        }

        var file = args.File;
        if (file is null)
            return;

        try
        {
            var previousPath = _form.ManualAssetRelativePath;
            var relativePath = await AdminAssetUploadService.SaveEntityPreviewAsync(AdminEntityType.Item, _form.Id, file);
            var saveResult = await ItemAdminService.SaveManualAssetAsync(_form.Id, relativePath);

            if (!string.IsNullOrWhiteSpace(previousPath) && !string.Equals(previousPath, relativePath, StringComparison.OrdinalIgnoreCase))
                await AdminAssetUploadService.DeleteIfExistsAsync(previousPath);

            var baseStatus = $"PNG manual asociado al item #{_form.Id}.";
            _status = saveResult.HasInfos
                ? $"{baseStatus} {string.Join(" ", saveResult.Infos)}"
                : baseStatus;
            _warning = saveResult.HasWarnings
                ? string.Join(" ", saveResult.Warnings)
                : null;
            _error = saveResult.HasErrors
                ? string.Join(" ", saveResult.Errors)
                : null;
            await ReloadAsync();
            await LoadItemAsync(_form.Id, preserveFeedback: true);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task ClearManualAssetAsync()
    {
        if (_form.Id <= 0 || string.IsNullOrWhiteSpace(_form.ManualAssetRelativePath))
            return;

        try
        {
            var currentPath = _form.ManualAssetRelativePath;
            await ItemAdminService.ClearManualAssetAsync(_form.Id);
            await AdminAssetUploadService.DeleteIfExistsAsync(currentPath);
            _status = $"PNG manual removido del item #{_form.Id}.";
            _warning = null;
            _error = null;
            await ReloadAsync();
            await LoadItemAsync(_form.Id, preserveFeedback: true);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

