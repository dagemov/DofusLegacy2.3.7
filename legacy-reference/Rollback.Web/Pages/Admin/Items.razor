    private async Task RefreshTypedItemIdStateAsync()
    {
        if (_selectedItemId.HasValue)
        {
            _typedItemIdExists = true;
            _itemIdStatus = $"Editando el item existente #{_form.Id}.";
            _isCheckingTypedItemId = false;
            return;
        }

        if (string.IsNullOrWhiteSpace(_itemIdInput))
        {
            _typedItemIdExists = false;
            _itemIdStatus = "Escribe un Id de template SQL para crear el item.";
            _isCheckingTypedItemId = false;
            return;
        }

        if (!int.TryParse(_itemIdInput.Trim(), out var parsedId))
        {
            _typedItemIdExists = false;
            _itemIdStatus = "El Id del item debe ser numerico.";
            _isCheckingTypedItemId = false;
            return;
        }

        if (parsedId <= 0 || parsedId > short.MaxValue)
        {
            _typedItemIdExists = false;
            _itemIdStatus = $"El Id debe estar entre 1 y {short.MaxValue}.";
            _isCheckingTypedItemId = false;
            return;
        }

        var currentCheck = ++_typedItemIdCheckVersion;
        _isCheckingTypedItemId = true;
        _itemIdStatus = "Validando si el Id ya existe...";
        var exists = await ItemAdminService.ExistsAsync((short)parsedId);
        if (currentCheck != _typedItemIdCheckVersion)
            return;

        _isCheckingTypedItemId = false;
        _typedItemIdExists = exists;
        _itemIdStatus = await ItemAdminService.DescribeTypedItemIdAsync((short)parsedId);
    }

    private async Task LoadTypedExistingItemAsync()
    {
        if (!TryApplyItemIdInput(out _))
            return;

        if (_form.Id <= 0 || !await ItemAdminService.ExistsAsync(_form.Id))
            return;

        await LoadItemAsync(_form.Id, preserveFeedback: true);
    }

    private bool TryApplyItemIdInput(out string? error)
    {
        error = null;

        if (_selectedItemId.HasValue)
        {
            if (_form.Id <= 0)
            {
                error = "El item cargado no tiene un Id valido.";
                return false;
            }

            _itemIdInput = _form.Id.ToString();
            return true;
        }

        if (string.IsNullOrWhiteSpace(_itemIdInput))
        {
            error = "El item necesita un Id de template SQL. No puede ir vacio.";
            return false;
        }

        if (!int.TryParse(_itemIdInput.Trim(), out var parsedId))
        {
            error = "El Id del item debe ser numerico.";
            return false;
        }

        if (parsedId <= 0 || parsedId > short.MaxValue)
        {
            error = $"El Id del item debe estar entre 1 y {short.MaxValue}. Si pusiste un numero grande para probar, el sistema no lo soporta porque items_templates.Id sigue siendo SMALLINT.";
            return false;
        }

        _form.Id = (short)parsedId;
        _itemIdInput = _form.Id.ToString();
        return true;
    }

    private string GetItemIdStatusCss()
    {
        if (_isCheckingTypedItemId)
            return string.Empty;

        return _typedItemIdExists
            ? "warning"
            : "success";
    }

    private string GetVisibleDisplayName()
    {
        if (!string.IsNullOrWhiteSpace(_form.OverrideName))
            return _form.OverrideName.Trim();

        if (!string.IsNullOrWhiteSpace(_form.ClientName))
            return _form.ClientName.Trim();

        if (!string.IsNullOrWhiteSpace(_form.Name))
            return _form.Name.Trim();

        return _form.Id > 0 ? $"Item #{_form.Id}" : "Item nuevo";
    }

    private string GetVisibleDisplayNameWithId() =>
        _form.Id > 0
            ? ItemAdminService.FormatDisplayNameWithId(GetVisibleDisplayName(), _form.Id)
            : GetVisibleDisplayName();

    private string GetVisibleNameSourceLabel()
    {
        if (!string.IsNullOrWhiteSpace(_form.OverrideName) || !string.IsNullOrWhiteSpace(_form.OverrideDescription))
            return "Manual";

        if (!string.IsNullOrWhiteSpace(_form.ClientName) || !string.IsNullOrWhiteSpace(_form.ClientDescription))
            return "Cliente ES";

        return string.IsNullOrWhiteSpace(_form.NameSourceLabel) ? "Fallback" : _form.NameSourceLabel;
    }

    private string GetClientBitmapFileName() =>
        _form.ClientIconId is > 0
            ? $"{_form.ClientIconId}.png"
            : "sin dato";

    private bool ShowAppearanceMismatch() =>
        _form.ClientAppearanceId is > 0 &&
        _form.AppearanceId > 0 &&
        _form.ClientAppearanceId != _form.AppearanceId;

    private static string FormatItemNameWithId(string? name, short itemId) =>
        ItemAdminService.FormatDisplayNameWithId(name, itemId);

    private string GetReferenceSetDisplay()
    {
        if (_form.ReferenceSetId is not > 0)
            return "sin dato";

        if (!string.IsNullOrWhiteSpace(_form.ReferenceSetName))
            return $"{_form.ReferenceSetName} [#{_form.ReferenceSetId}]";

        return $"Set #{_form.ReferenceSetId}";
    }

    private static string GetAuditChipCss(ItemAuditStatus status) =>
        status switch
        {
            ItemAuditStatus.Aligned => "audit-aligned",
            ItemAuditStatus.LegacyRuntimeItem => "audit-runtime-drift",
            ItemAuditStatus.MissingClientMetadata => "audit-missing-runtime",
            ItemAuditStatus.MissingReferenceMetadata => "audit-metadata-missing",
            ItemAuditStatus.MissingName => "audit-metadata-missing",
            ItemAuditStatus.MissingIcon => "audit-metadata-missing",
            ItemAuditStatus.IncompleteTemplate => "audit-runtime-drift",
            ItemAuditStatus.RuntimeOnly => "audit-ambiguous",
            ItemAuditStatus.MissingRuntime => "audit-missing-runtime",
            _ => "audit-ambiguous",
        };
}
