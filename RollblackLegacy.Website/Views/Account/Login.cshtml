@model LoginAccountPageViewModel
@{
    ViewData["Title"] = "Iniciar sesion";
    ViewData["ActiveNav"] = "login";
}

<div class="auth-page">
    <div class="auth-page__inner">
        <section class="auth-panel" id="login-auth-panel">
            <span class="auth-panel__eyebrow">@Model.Brand.Eyebrow</span>
            <h1 class="auth-panel__title">@Model.Title</h1>
            <p class="auth-panel__subtitle">@Model.Subtitle</p>
            @await Html.PartialAsync("~/Views/Account/_LoginForm.cshtml", Model)
        </section>

        <nav class="auth-page__footer" aria-label="Enlaces relacionados">
            <a href="/account/register">Crear cuenta</a>
            <span aria-hidden="true">·</span>
            <a href="@Model.LauncherDownloadUrl" target="_blank" rel="noopener noreferrer">Descargar launcher</a>
        </nav>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
