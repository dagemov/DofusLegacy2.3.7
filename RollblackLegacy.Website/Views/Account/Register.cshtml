@model RegisterAccountPageViewModel
@{
    ViewData["Title"] = "Registro";
    ViewData["ActiveNav"] = "register";
}

<div class="auth-page auth-page--register">
    <div class="auth-register">
        <aside class="auth-register__visual" aria-hidden="false">
            <img src="@Model.ServerImagePath"
                 alt="@Model.Brand.Name"
                 class="auth-register__image"
                 loading="lazy" />
        </aside>

        <div class="auth-register__main">
            @if (Model.Result?.Succeeded != true)
            {
                <h1 class="auth-register__title">Crear cuenta</h1>
            }

            <section class="auth-panel auth-panel--compact" id="register-auth-panel">
                @if (Model.Result?.Succeeded == true)
                {
                    ViewData["LauncherDownloadUrl"] = Model.LauncherDownloadUrl;
                    ViewData["AdobeAirDownloadUrl"] = Model.AdobeAirDownloadUrl;
                    @await Html.PartialAsync("~/Views/Account/_RegisterSuccess.cshtml", Model.Result)
                }
                else
                {
                    @await Html.PartialAsync("~/Views/Account/_RegisterForm.cshtml", Model.Form)
                }
            </section>

            <nav class="auth-page__footer" aria-label="Enlaces relacionados">
                <a href="@Model.LauncherDownloadUrl" target="_blank" rel="noopener noreferrer">Descargar launcher</a>
                <span aria-hidden="true">·</span>
                <a href="/account/login">Iniciar sesion</a>
            </nav>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
