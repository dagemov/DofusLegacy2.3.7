@model RegisterAccountResultViewModel
@{
    string launcherUrl = ViewData["LauncherDownloadUrl"] as string ?? "#";
    string adobeUrl = ViewData["AdobeAirDownloadUrl"] as string ?? "#";
}

<div class="register-success">
    @await Html.PartialAsync("~/Views/Shared/Atoms/_Badge.cshtml", new BadgeViewModel
    {
        Label = "Cuenta creada",
        Tone = "success",
        IconPath = "/images/status/server-on.png"
    })

    <h3 class="register-success__title">@Model.Title</h3>
    <p class="register-success__message">@Model.Message</p>

    <div class="register-success__meta">
        <div>
            <span class="register-success__label">Usuario</span>
            <strong>@Model.Username</strong>
        </div>
        <div>
            <span class="register-success__label">Email</span>
            <strong>@Model.Email</strong>
        </div>
    </div>

    @if (Model.UsesWebsiteContactTable)
    {
        <p class="register-success__note" style="color:var(--ol-muted);font-size:0.88rem;">
            El email se guarda en la tabla complementaria del esquema web.
        </p>
    }

    <p class="landing-section__subtitle" style="margin:0;">Siguiente paso: descarga el launcher e instala Adobe AIR antes de abrir el cliente.</p>

    <div class="register-success__actions">
        @await Html.PartialAsync("~/Views/Shared/Atoms/_Button.cshtml", new ButtonAtomViewModel
        {
            Label = "Iniciar sesion",
            Href = "/account/login",
            Variant = "primary",
            Icon = "fa-solid fa-right-to-bracket",
            Size = "xl",
        })
        @await Html.PartialAsync("~/Views/Shared/Atoms/_Button.cshtml", new ButtonAtomViewModel
        {
            Label = "Descargar launcher",
            Href = launcherUrl,
            Variant = "secondary",
            Icon = "fa-solid fa-download",
            Size = "xl",
            IsExternal = launcherUrl.StartsWith("http", StringComparison.OrdinalIgnoreCase),
        })
        @await Html.PartialAsync("~/Views/Shared/Atoms/_Button.cshtml", new ButtonAtomViewModel
        {
            Label = "Descargar Adobe AIR",
            Href = adobeUrl,
            Variant = "ghost",
            Icon = "fa-solid fa-plug-circle-exclamation",
            Size = "xl",
            IsExternal = adobeUrl.StartsWith("http", StringComparison.OrdinalIgnoreCase),
        })
    </div>
</div>
