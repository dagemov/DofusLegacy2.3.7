@model LoginAccountPageViewModel

<section class="auth-panel" id="login-auth-panel">
    <span class="auth-panel__eyebrow">@Model.Brand.Eyebrow</span>
    <h1 class="auth-panel__title">@Model.Title</h1>
    <p class="auth-panel__subtitle">@Model.Subtitle</p>
    @await Html.PartialAsync("~/Views/Account/_LoginForm.cshtml", Model)
</section>
