@model BrandIdentityViewModel

<header class="site-header">
    <div class="container-xl site-header__inner">
        @await Html.PartialAsync("~/Views/Shared/Atoms/_Logo.cshtml", Model)

        <nav class="site-header__nav" aria-label="Public navigation">
            <a href="/" class="site-header__link">Home</a>
            @if (User?.Identity?.IsAuthenticated == true)
            {
                <span class="site-header__link site-header__user">@User.Identity!.Name</span>
                <form asp-controller="Account" asp-action="Logout" method="post" class="site-header__logout-form">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="site-header__link site-header__link--button">Salir</button>
                </form>
            }
            else
            {
                <a href="/account/login" class="site-header__link">Login</a>
                <a href="/account/register" class="site-header__link">Registro</a>
            }
        </nav>
    </div>
</header>
