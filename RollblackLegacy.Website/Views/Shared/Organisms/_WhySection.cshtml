@model IReadOnlyList<NewsItemViewModel>

<section id="porque">
    <div class="container">
        <div class="section-header reveal">
            <span class="section-label">Por que Rollblack</span>
            <h2 class="section-title">La beta que buscabas</h2>
        </div>
        <div class="why-grid">
            @foreach (var item in Model)
            {
                <div class="why-card reveal">
                    <span class="tag">@item.Label</span>
                    <h3>@item.Title</h3>
                    <p>@item.Summary</p>
                </div>
            }
        </div>
    </div>
</section>
