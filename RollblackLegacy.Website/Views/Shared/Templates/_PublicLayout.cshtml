@inject IConfiguration Configuration
@using RollblackLegacy.Website.Infrastructure
@{
    var brand = WebsiteViewModelFactory.CreateBrand(Configuration);
    var title = ViewData["Title"] as string;
    var bodyClass = ViewData["BodyClass"] as string ?? string.Empty;
    ViewData["DiscordUrl"] = Configuration["Website:DiscordUrl"] ?? "https://discord.gg/4MJ83yhdp";
}
<!DOCTYPE html>
<html lang="es" class="launcher-html">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(string.IsNullOrWhiteSpace(title) ? brand.Name : $"{title} | {brand.Name}")</title>
    <meta name="description" content="@brand.Description" />
    <link rel="icon" href="@brand.FaviconPath" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Chivo:wght@400..700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />
    <link rel="stylesheet" href="~/css/launcher-shell.css" asp-append-version="true" />
</head>
<body class="launcher-body @bodyClass">
    <div class="launcher-app">
        <div class="launcher-app__backdrop" aria-hidden="true"></div>

        @await Html.PartialAsync("~/Views/Shared/Organisms/_LauncherSidebar.cshtml", brand)

        <main class="launcher-main" id="main-content">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/htmx.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
