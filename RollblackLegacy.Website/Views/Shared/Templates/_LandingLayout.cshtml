@inject IConfiguration Configuration
@using RollblackLegacy.Website.Infrastructure
@{
    var brand = WebsiteViewModelFactory.CreateBrand(Configuration);
    var title = ViewData["Title"] as string;
    var bodyClass = ViewData["BodyClass"] as string ?? string.Empty;
    ViewData["DiscordUrl"] = Configuration["Website:DiscordUrl"] ?? "https://discord.gg/4MJ83yhdp";
    var faVersion = Configuration["Website:Cdn:FontAwesomeVersion"] ?? "6.7.2";
    bool isHome = ViewData["IsHomePage"] as bool? == true;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(string.IsNullOrWhiteSpace(title) ? $"{brand.Name} — Servidor Privado Dofus 2.0.0" : $"{title} | {brand.Name}")</title>
    <meta name="description" content="@brand.Description" />
    <link rel="icon" href="@brand.FaviconPath" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/@@fortawesome/fontawesome-free@(faVersion)/css/all.min.css"
          crossorigin="anonymous"
          referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/css/rollblack-landing.css" asp-append-version="true" />
</head>
<body class="rb-landing @bodyClass">
    <div class="bg-mesh" aria-hidden="true"></div>
    <div class="bg-grid" aria-hidden="true"></div>
    <div class="particles" id="particles" aria-hidden="true"></div>

    @await Html.PartialAsync("~/Views/Shared/Organisms/_LandingNav.cshtml", brand)

    <main id="main-content">
        @RenderBody()
    </main>

    @await Html.PartialAsync("~/Views/Shared/Organisms/_LandingFooter.cshtml", brand)

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/htmx.org@2.0.4"></script>
    @if (isHome)
    {
        <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
    }
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (isHome)
    {
        <script src="~/js/landing-home.js" asp-append-version="true"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
